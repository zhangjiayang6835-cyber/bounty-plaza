diff --git a/tests/amount.test.ts b/tests/amount.test.ts
index 97c46ab..c992a5a 100644
--- a/tests/amount.test.ts
+++ b/tests/amount.test.ts
@@ -7,6 +7,7 @@ import {
   significantDecimals,
   assertDestinationPrecision,
 } from "../src/utils/amount.js";
+import { convertPrecision } from "../src/utils/encoding.js";
 import { ARC_TESTNET, STELLAR_TESTNET } from "../src/constants.js";
 
 describe("decimalsForChain", () => {
@@ -89,3 +90,60 @@ describe("significantDecimals and assertDestinationPrecision", () => {
     expect(() => assertDestinationPrecision("1.1234567", "stellar")).not.toThrow();
   });
 });
+
+// Round trips through the public helpers. `convertPrecision` sits between the two
+// chains' scales, so an amount that survives arc -> stellar -> arc must come back
+// byte-identical, and the one direction that loses information (7 -> 6) must
+// truncate rather than round.
+describe("cross-chain decimal round trips", () => {
+  it("survives up-scale then down-scale without drift", () => {
+    for (const amount of ["0", "1", "10.5", "0.000001", "1234.567891"]) {
+      const arcRaw = toRawAmount(amount, "arc");
+      const stellarRaw = convertPrecision(arcRaw, 6, 7);
+      const backToArc = convertPrecision(stellarRaw, 7, 6);
+      expect(backToArc).toBe(arcRaw);
+      expect(fromRawAmount(backToArc, "arc")).toBe(amount);
+    }
+  });
+
+  it("keeps the extra digit when landing on stellar", () => {
+    const arcRaw = toRawAmount("10.50", "arc");
+    const stellarRaw = convertPrecision(arcRaw, 6, 7);
+    expect(stellarRaw).toBe(105_000_000n);
+    expect(fromRawAmount(stellarRaw, "stellar")).toBe("10.5");
+  });
+
+  it("truncates the seventh decimal when coming back to arc", () => {
+    // 1.1234567 USDC exists on Stellar's scale but not on Arc's
+    const stellarRaw = toRawAmount("1.1234567", "stellar");
+    expect(stellarRaw).toBe(11_234_567n);
+    const arcRaw = convertPrecision(stellarRaw, 7, 6);
+    expect(arcRaw).toBe(11_234_567n / 10n);
+    expect(fromRawAmount(arcRaw, "arc")).toBe("1.123456");
+  });
+
+  it("truncates toward zero for sub-unit remainders", () => {
+    expect(convertPrecision(9n, 7, 6)).toBe(0n);
+    expect(fromRawAmount(0n, "arc")).toBe("0");
+  });
+
+  it("round-trips zero in both directions", () => {
+    expect(convertPrecision(convertPrecision(0n, 6, 7), 7, 6)).toBe(0n);
+    expect(fromRawAmount(toRawAmount("0.000000", "arc"), "arc")).toBe("0");
+  });
+
+  it("round-trips the maximum arc precision exactly", () => {
+    const max = "0.999999";
+    expect(fromRawAmount(toRawAmount(max, "arc"), "arc")).toBe(max);
+  });
+
+  it("round-trips the maximum stellar precision through stellar", () => {
+    const max = "0.9999999";
+    expect(fromRawAmount(toRawAmount(max, "stellar"), "stellar")).toBe(max);
+  });
+
+  it("is a no-op when both decimal scales match", () => {
+    const raw = toRawAmount("42.42", "arc");
+    expect(convertPrecision(raw, 6, 6)).toBe(raw);
+  });
+});
