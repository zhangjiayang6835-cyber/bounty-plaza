+def test_uniform_all_ones_seed_and_narrow_fp32_range(device):
+    """Regression guard for issue #52014 range/seed edge cases.
+
+    The hardware XNOR-LFSR all-ones state is a lock state, and subtracting a fixed 1e-6 from the
+    upper bound destroys narrow FP32 intervals.  This pins both behaviours at the public ttnn API.
+    """
+    shape = (256, 256)
+    low = torch.tensor(1.0, dtype=torch.float32).item()
+    high_t = torch.tensor(low, dtype=torch.float32)
+    for _ in range(8):
+        high_t = torch.nextafter(high_t, torch.tensor(2.0, dtype=torch.float32))
+    high = high_t.item()
+    npu = ttnn.from_torch(
+        torch.zeros(shape, dtype=torch.float32), device=device, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT
+    )
+
+    ttnn.uniform(npu, low, high, 0xFFFFFFFF)
+    out = ttnn.to_torch(npu).float()
+
+    assert torch.isfinite(out).all()
+    assert out.min() >= low
+    assert out.max() < high
+    assert out.max() > low, "narrow FP32 range must not collapse to the lower endpoint"
+    assert torch.unique(out).numel() > 1, "all-ones seed must not lock the SFPU PRNG to one value"
+
+
+def test_uniform_sfpu_quality_regression(device):
+    """Catch raw-LFSR exposure in the SFPU uniform path.
+
+    The check is intentionally broad rather than a full randomness test: fixed-seed output should have
+    sane mean/std, weak adjacent-sample correlation, and roughly balanced low numeric buckets.
+    """
+    npu = ttnn.from_torch(
+        torch.zeros((512, 512), dtype=torch.float32), device=device, dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT
+    )
+
+    ttnn.uniform(npu, 0.0, 1.0, 0x12345678)
+    out = ttnn.to_torch(npu).float().flatten()
+
+    assert torch.isfinite(out).all()
+    assert abs(out.mean().item() - 0.5) < 0.01
+    assert abs(out.std(unbiased=False).item() - (1.0 / 12.0) ** 0.5) < 0.01
+
+    centered = out - out.mean()
+    adjacent_corr = torch.mean(centered[:-1] * centered[1:]) / torch.mean(centered * centered)
+    assert abs(adjacent_corr.item()) < 0.02
+
+    hist = torch.histc(out, bins=64, min=0.0, max=1.0)
+    expected = out.numel() / 64
+    assert ((hist - expected).abs() / expected).max().item() < 0.10
+
+    bucket_count = 4096
+    buckets = torch.clamp((out * bucket_count).to(torch.int64), 0, bucket_count - 1)
+    low_bucket_bit_ratio = (buckets & 1).float().mean().item()
+    assert 0.49 < low_bucket_bit_ratio < 0.51
+
+
