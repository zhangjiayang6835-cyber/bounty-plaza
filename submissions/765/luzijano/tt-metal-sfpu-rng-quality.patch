+// start from adjacent LFSR states.
+uint32_t mix_uniform_seed(uint32_t seed, uint32_t core_index) {
+    uint32_t z = seed + 0x9e3779b9u * (core_index + 1u);
+    z = (z ^ (z >> 16)) * 0x7feb352du;
+    z = (z ^ (z >> 15)) * 0x846ca68bu;
+    z = z ^ (z >> 16);
+    // Avoid invalid/degenerate PRNG states.  Zero is reserved by this op for "choose a random
+    // seed" and all-ones locks the hardware XNOR LFSR.
+    if (z == 0u || z == std::numeric_limits<uint32_t>::max()) {
+        z ^= 0xa5a5a5a5u;
+    }
+    return z;
