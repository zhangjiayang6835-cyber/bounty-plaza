[MAIN]
init-hook='import sys; sys.path.insert(0, "."); sys.path.insert(0, "scripts")'
max-line-length=120

[DESIGN]
max-attributes=20
max-locals=25
max-returns=12
max-branches=20
max-statements=60
max-args=10
max-positional-arguments=10
min-public-methods=1

[MESSAGES CONTROL]
disable=too-few-public-methods
