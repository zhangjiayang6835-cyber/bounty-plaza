<content>
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowPassRoleToSpecificService",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/{{ROLE_NAME}}",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "{{SERVICE_NAME}}"
                },
                "ArnLike": {
                    "aws:SourceArn": "{{SOURCE_ARN_PATTERN}}"
                }
            }
        },
        {
            "Sid": "AllowEC2RunInstances",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances",
                "ec2:DescribeInstances"
            ],
            "Resource": [
                "arn:aws:ec2:{{REGION}}::image/{{AMI_ID}}",
                "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/{{SECURITY_GROUP_ID}}",
                "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:subnet/{{SUBNET_ID}}",
                "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:volume/{{VOLUME_ID}}"
            ]
        }
    ]
}
</content>