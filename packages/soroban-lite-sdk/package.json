{
  "name": "soroban-lite-sdk",
  "version": "0.3.0",
  "description": "A lightweight, strongly-typed TypeScript SDK for Stellar Soroban smart contract interactions with wallet integration support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "blockchain",
    "rpc",
    "typescript",
    "sdk",
    "web3",
    "defi",
    "freighter",
    "stellar-wallets-kit"
  ],
  "author": "Soroban Lite SDK Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/soroban-lite-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/soroban-lite-sdk/issues"
  },
  "homepage": "https://github.com/your-org/soroban-lite-sdk#readme",
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": ">=1.0.0",
    "@stellar/freighter-api": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    },
    "@stellar/freighter-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.1.7",
    "@stellar/freighter-api": "^2.1.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
