// TSIG key configuration
key "slave-key" {
    algorithm hmac-sha256;
    secret "YOUR_TSIG_SECRET_KEY_HERE=";
};

key "update-key" {
    algorithm hmac-sha256;
    secret "YOUR_UPDATE_SECRET_KEY_HERE=";
};

// Key for specific slave servers
key "slave1.example.com" {
    algorithm hmac-sha256;
    secret "SLAVE1_SECRET_KEY_HERE=";
};

key "slave2.example.com" {
    algorithm hmac-sha256;
    secret "SLAVE2_SECRET_KEY_HERE=";
};
