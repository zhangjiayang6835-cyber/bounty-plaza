// Internal zones (split-horizon DNS)
zone "internal.example.com" {
    type master;
    file "/etc/bind/db.internal.example.com";
    
    // Allow zone transfer only to slave servers using TSIG
    allow-transfer { key transfer-key; 192.168.1.100; };
    allow-query { 10.0.0.0/8; 192.168.0.0/16; 172.16.0.0/12; };
};

// External zones
zone "example.com" {
    type master;
    file "/etc/bind/db.example.com";
    
    // Allow zone transfer only to slave servers using TSIG
    allow-transfer { key transfer-key; 203.0.113.10; };
    allow-query { any; };
};

// Reverse zones
zone "1.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168.1";
    allow-transfer { key transfer-key; 192.168.1.100; };
    allow-query { 10.0.0.0/8; 192.168.0.0/16; 172.16.0.0/12; };
};