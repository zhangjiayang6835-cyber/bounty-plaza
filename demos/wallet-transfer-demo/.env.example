# Onderhaus paymaster, used by the optional "sponsored" completion. When both are set, a pending
# transfer can be finished by Onderhaus, which pays the destination fee, with no destination
# wallet. Leave them unset to hide the sponsor option entirely.
# VITE_ vars are inlined into the client bundle at build time, so use a key scoped for this.
VITE_ONDERHAUS_URL=
VITE_ONDERHAUS_KEY=
